# Node dependencies / build output
node_modules/
dist/
build/
coverage/
.npm/
.eslintcache

# Tests and dev-only config (excluded from the runtime image;
# the multi-stage Dockerfile only copies dist/ into the final stage,
# but keeping these out of the build context speeds up context transfer)
src/**/*.test.ts
src/**/*.spec.ts
__tests__/
jest.config.js
.eslintrc.json

# TypeScript incremental build info
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# VCS / editor / OS metadata
.git/
.gitignore
.gitattributes
.editorconfig
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs and env files
*.md
.env
.env.*
!.env.example

# Docker files themselves
Dockerfile
.dockerignore
