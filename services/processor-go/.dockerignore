# Go build artifacts
processor
*.exe
*.test
*.out
bin/
vendor/

# Test files (excluded from the runtime image; `go build` ignores them anyway,
# but keeping them out of the build context shrinks what is sent to the daemon)
*_test.go
testdata/

# Go tool caches (in case they end up under the working directory)
.cache/

# VCS / editor / OS metadata
.git/
.gitignore
.gitattributes
.editorconfig
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docs and env files
*.md
.env
.env.*
!.env.example

# Docker files themselves
Dockerfile
.dockerignore
